FROM busybox as extractor
ARG OILS_VER=0.38.0
RUN \
   mkdir /pkg && \
   wget -O- https://oils.pub/download/oils-for-unix-${OILS_VER}.tar.gz | tar -xvz -C /pkg --strip-components 1

FROM scratch as srcpkg
COPY --from=extractor /pkg /

FROM chimeralinux/chimera as buildbase
RUN \
  apk update && \
  apk add clang musl-devel-static libunwind-devel-static libcxx-devel-static libatomic-chimera-devel-static

FROM buildbase as build
ENV CC=clang CLFAGS="-static -flto" LDFLAGS="-static -flto"
RUN \
  --mount=type=bind,from=srcpkg,dst=/src,rw \
  cd /src && \
  /src/configure --prefix='' \
    --without-readline \
    --without-systemtap-sdt && \
  /src/_build/oils.sh && \
  mkdir /out && \
  DESTDIR=/out /src/install 

FROM chimeralinux/chimera as installer
RUN \
  --mount=type=bind,from=build,src=/out,dst=/pkg \
  mkdir /out && \
  install /pkg/bin/oils-for-unix /out && \
  ln -sTf ./oils-for-unix /out/osh && \
  ln -sTf ./oils-for-unix /out/ysh

FROM scratch as oils
LABEL \
  org.opencontainers.image.title="Oils for Unix" \
  org.opencontainers.image.description="A statically-linked copy of Oils for unix, not very useful on it's own" \
  org.opencontainers.authors="Aaron B. Haun <aaron@haun.guru>"
COPY --from=installer /out /bin
ENV SHELL=/bin/osh
ENTRYPOINT [ "/bin/osh" ]

